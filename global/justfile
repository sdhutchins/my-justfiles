# Update Conda and all packages in base environment
[group('updates')]
update-conda-all:
    conda update -n base --all

# Update Homebrew and all packages
[group('updates')]
update-brew:
    brew update
    brew upgrade
    brew cleanup

# Update Mamba
[group('updates')]
update-mamba:
    conda update -n base mamba

# System health check
[group('system')]
doctor:
    @echo "== Toolchain versions =="
    python3 --version
    git --version
    node --version || true
    ruby --version || true

    @echo "\n== Binary resolution =="
    which python3
    which pip3
    which git
    which ruby

# Update zsh
[group('updates')]
bump-zsh:
    omz update

# Backup file system
[group('system')]
backup:
    "{{home}}/rclone_backup.sh"

# Organize Downloads
[group('system')]
organize:
